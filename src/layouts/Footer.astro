---
import { BsDiscord } from "react-icons/bs";
import { FaInstagramSquare } from "react-icons/fa";
import { FaFacebook, FaGithub, FaLinkedin, FaTiktok } from "react-icons/fa6";
import { IoLogoYoutube } from "react-icons/io";
import { MdPhone, MdEmail, MdPlace } from "react-icons/md";
import Logo from "../components/Logo/Logo.astro";
---

<footer class="footer p-4 bg-cdh-dark text-white w-full md:grid md:grid-cols-[2fr_1fr_1fr] gap-4">
	<section class="cdh">
    <div>
      <Logo />
      <p class="opacity-70 mt-2">Promovendo o desenvolvimento tecnológico e a Inovação em Angola através da colaboração entre Desenvolvedores.</p>
    </div>

    <div class="redes mt-4">
      <ul class="w-full flex gap-3">
        <li>
          <a href="https://www.facebook.com/share/g/16uintnTJE/?mibextid=wwXIfr" alt="Link para o facebook da cdh" target="_blank">
            <FaFacebook size={20} className="text-gray-300 hover:text-cdh-blue"/>
          </a>
        </li>

        <li>
          <a href="https://www.instagram.com/cdh.community/" alt="Link para o instagram da cdh" target="_blank" class="hover:text-cdh-pink">
            <FaInstagramSquare size={20} className="text-gray-300 hover:text-cdh-pink"/>
          </a>
        </li>

        <li>
          <a href="https://www.tiktok.com/@cdh.community" target="_blank" alt="Link para o Linkedin da cdh">
            <FaLinkedin size={20} className="text-gray-300 hover:text-cdh-blue"/>
          </a>
        </li>

        <li>
          <a href="https://www.tiktok.com/@cdh.community" alt="Link para o titok da cdh" target="_blank">
            <FaTiktok size={20} className="text-gray-300 hover:text-black"/>
          </a>
        </li>

        <li>
          <a href="https://github.com/cdh-community-ao" alt="Link para o github da cdh" target="_blank">
            <FaGithub size={20} className="text-gray-300 hover:text-black"/>
          </a>
        </li>

        <li>
          <a href="https://www.youtube.com/@cdh.community" alt="Link para o youtube da cdh" target="_blank">
            <IoLogoYoutube size={20} className="text-gray-300 hover:text-red-600"/>
          </a>
        </li>

        <li>
          <a href="https://discord.gg/HH4szPQ5" alt="Link para o discord da cdh" target="_blank">
            <BsDiscord size={20} className="text-gray-300 hover:text-cdh-blue"/>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="links-rapidos mt-6">
    <h4 class="font-bold text-xl">Links Rápidos</h4>
    <ul class="text-gray-300 mt-1">
      <li><a href="/" alt="Link para a home" class="hover:text-white">Home</a></li>
      <li><a href="/quem-somos" alt="Link para a página quem somos" class="hover:text-white">Quem somos</a></li>
      <li><a href="/equipa" alt="Link para a página equipa" class="hover:text-white">Equipa</a></li>
      <li><a href="/contatos" alt="Link para a home" class="hover:text-white">Contato</a></li>
    </ul>
  </section>

  <section class="info-contato mt-6">
    <h4 class="font-bold text-xl">Contato</h4>
    <ul class="mt-1 text-gray-300">
      <li class="hover:text-white mt-2"><MdPlace  className="inline text-cdh-orange"/> Huambo, Angola.</li>
      <li class="hover:text-white mt-2"><MdEmail className="inline text-cdh-orange mr-1"/>cdh.community.ao@outlook.com</li>
    </ul>
  </section>

  <section class="copyriht col-span-3 mt-6 border-t border-white/10 pt-4 text-xs opacity-70">
    <p class="font-md text-center">&copy {new Date().getFullYear()} Comunidade de Desenvolvedores do Huambo. Todos os direitos reservados.</p>
	</section>
</footer>