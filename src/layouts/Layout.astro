---
import "../styles/global.css";
const {title = "CDH | Comunidade de desenvolvedores do Huambo"} = Astro.props;
---
<!doctype html>
<html lang="pt-ao">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
	    <main class="main">
		    <slot />
		</main>
	</body>
</html>