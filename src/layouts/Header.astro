---
import MobileMenu from "../components/MobileMenu/MobileMenu.astro";
import Logo from "../components/Logo/Logo.astro";
import { MdOutlineMenu} from "react-icons/md";

const links = [
  { href: "/", label: "Início" },
  { href: "/quem-somos", label: "Quem Somos" },
  { href: "/blog", label: "Blog"},
  { href: "/equipa", label: "Equipa"},
  { href: "/contatos", label: "Contato" },
];
---

<header class="w-full bg-white shadow-md fixed top-0 p-2 z-20">
  <section class="max-w-7xl mx-auto flex items-center justify-between p-4 py-2">
    <!-- Logo -->
    <div class="text-9xl font-bold">
      <a href="/">
        <Logo />
      </a>
    </div>

    <!-- Menu desktop -->
    <nav class="hidden md:flex gap-8 text-gray-700 font-medium">
      {links.map((link) => (
        <a href={link.href} class="p-2 rounded-md hover:text-white hover:p-2 hover:rounded-md hover:bg-orange-400 transition">{link.label}</a>
      ))}
    </nav>

    <!-- Botão menu mobile -->
    <button class="md:hidden p-2 rounded-lg border border-gray-300 hover:bg-gray-100" aria-label="Abrir menu" id="menu-toggle">
      <MdOutlineMenu size="30px" color="black">
    </button>
  </section>

  <!-- mobile menu -->
  <MobileMenu links={links} />
</header>
