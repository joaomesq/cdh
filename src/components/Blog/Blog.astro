---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import BlogModal from './BlogModal.astro';

const posts = (await getCollection('blog')).sort((a, b) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const renderedPosts = [];

for (const post of posts) {
  const { Content } = await post.render();
  renderedPosts.push({ ...post, Content });
}
---

<script is:inline>
  function openModal(slug) {
    const modal = document.getElementById(`modal-${slug}`);
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(slug) {
    const modal = document.getElementById(`modal-${slug}`);
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }
</script>

<section class="relative text-center py-32 mb-10 rounded-xl overflow-hidden">
  <div class="absolute inset-0">
    <img 
      src="/src/assets/imagens/banner.png" 
      alt="Imagem de fundo" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/60"></div>
  </div>
  <div class="relative z-10 max-w-3xl mx-auto px-5">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">
      Explore nossos Artigos Técnicos
    </h1>
    <p class="text-lg md:text-xl text-gray-200">
      Dicas práticas, experiências da comunidade, soluções em código — tudo isso você encontra aqui.
    </p>
  </div>
</section>


<ul class="grid grid-cols-1 md:grid-cols-2 gap-9 max-w-6xl mx-auto px-5">
  {renderedPosts.map(({ data, slug }) => (
    <BlogCard data={data} slug={slug} />
  ))}
</ul>

<section class="mt-16 bg-gradient-to-r from-[#E5A862] to-orange-500 rounded-2xl shadow-lg p-8 text-center text-white"> 
  <h2 class="text-3xl md:text-4xl font-bold mb-4">
    Continue a sua jornada de conhecimento 
  </h2>
  <p class="text-lg mb-6">
    Explore mais artigos, compartilhe ideias e faça parte da nossa comunidade de desenvolvimento.
  </p>
  <a href="/contato" 
     class="inline-block bg-white text-[#E5A862] font-semibold px-6 py-3 rounded-lg shadow hover:bg-orange-500 hover:text-white transition-transform transform hover:scale-105">
    Enviar meu artigo
  </a>
</section>

 <hr>


{renderedPosts.map(({ data, Content, slug }) => (
  <BlogModal data={data} slug={slug} Content={Content} />
))}
