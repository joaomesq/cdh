---
//componente
import Layout from '../layouts/Layout.astro';
import Equipa from '../components/Equipa/Equipa';
import Hero from '../components/Hero/Hero.astro';
---

<Layout>
  <section class="hero">
    <Hero titulo="Nossa Equipa" descricao="Conheça os departamentos que formam a espinha dorsal da CDH e os talentosos profissionais que os lideram."/>
  </section>
  
  <section class="departamentos p-4">
    <div class="text-center mt-8">
      <h2 class="text-3xl font-bold text-gray-700 mb-4">Nossos Departamentos</h2>
      <p class="text-xl text-gray-400 md:w-1/2 md:mx-auto">Cada departamento da CDH espcializa-se numa área específica da tecnologia, colaborando para criar soluções completas e inovadoras.</p>
    </div>
  </section>
</Layout>