---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from "astro:content";

export async function getStaticPaths(){
    const posts = await getCollection("noticias");
    return posts.map((post)=> ({
        params: {slug: post.slug},
        props: {post},
    }));
}

const { post } = Astro.props;
---

<Layout title = {`CDH | ${post.data.title}`}>

  <article class="container prose max-w-3xl py-12">
    <p class="text-sm text-gray-600">{new Date(post.data.publishedAt).toLocaleDateString('pt-PT')} — {post.data.category}</p>
    <h1 class="mb-4 text-3xl font-extrabold">{post.data.title}</h1>
    <div class="mb-6 h-[1px] w-full bg-gray-200"></div>
    <div set:html={post.body}></div>
  </article>


</Layout>