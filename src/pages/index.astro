---
//components
import Slider from '../components/Slider/Slider.tsx';
import Card from '../components/Card/Card.tsx';
import CallAction from '../components/Call-To-Action/Call-Action.tsx';
import Newsletter from '../components/Newsletter/Newsletter.tsx';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <section class="slide">
	    <Slider client:load/>
	</section>

	<section class="fazer-parte p-4 py-6 text-center mt-12 mb-8">
	    <div class="md:w-1/2 md:mx-auto">
		    <h2 class="font-bold mb-4 text-3xl text-gray-700">Por que fazer parte da CDH?</h2>
			<p class="text-gray-400 text-xl">A CDH ofere um ambiente colaborativo para desenvolvedores crescerem profissionalmente e contribuírem para o exossitema tecnológico angolano.</p>
		</div>

		<div class="cards-motivos mt-16 md:grid md:grid-cols-4 md:px-8 gap-4">
		    <Card titulo="Networking" background="bg-white" descricao="Conect-se com outros desenvolvedores, partilhe conhecimento e crie oportunidades de colaboração."/>
		    <Card titulo="Desenvolvimento Prático" descricao="Partice em projetos reais e desenvolva habilidades através de experiência práticas e colaborativos."/>
			<Card titulo="Inovação" descricao="Trabalhe em soluções inovadoras que impactem positivamente a comunidade anoglana." background="bg-white"/>
		    <Card titulo="Impacto Social" descricao="Contribua para projetos que geram impacto positivo na sociedade angolana através da tecnologia."
		</div>
	</section>
</Layout>
