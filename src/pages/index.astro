---
//components
import Slider from '../components/Slider/Slider.tsx';
import Card from '../components/Card/Card.tsx';
import CallAction from '../components/Call-To-Action/Call-Action.tsx';
import Newsletter from '../components/Newsletter/Newsletter.tsx';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <section class="slide">
	    <Slider client:load/>
	</section>

	<section class="fazer-parte p-4 text-center mt-12">
	    <div>
		    <h2 class="font-bold mb-4 text-3xl text-gray-700">Por que fazer parte da CDH?</h2>
			<p class="text-gray-400 text-xl">A CDH ofere um ambiente colaborativo para desenvolvedores crescerem profissionalmente e contribuírem para o exossitema tecnológico angolano.</p>
		</div>
	</section>
</Layout>
