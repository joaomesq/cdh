---
//components
import Slider from '../components/Slider/Slider.tsx';
import Card from '../components/Card/Card.tsx';
import CallAction from '../components/Call-To-Action/Call-Action.tsx';
import Newsletter from '../components/Newsletter/Newsletter.tsx';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <section class="slide">
	    <Slider client:load/>
	</section>

	<section class="destaques relative z-10 flex flex-col items-center text-center mt-20 p-4 h-[500px] bg-white">
	    <h4 class="font-bold text-orange-400 text-4xl">Áreas de atuação</h4>
		<div class="grid items-center mt-14 md:w-[70%] h-[200px] grid-cols-2 md:grid-cols-4 gap-1 text-white">
		   <div class="flex flex-col bg-orange-300 py-6 rounded-xl items-center">
			 <img src="/img/idea.png" class="w-[80px]">
			 <Card descricao="Formação e mentoria" background="bg-orange-400 w-[90%]"/>
		   </div>

		     <div class="flex flex-col bg-orange-300 py-6 rounded-xl items-center">
			 <img src="/img/eventos.png" class="w-[80px]">
		   <Card descricao="Hackathons e Eventos" background="bg-orange-400 w-[90%]"/>
		    </div>
		   <div class="flex flex-col bg-orange-300 py-6 rounded-xl items-center">
			 <img src="/img/projectos.png" class="w-[80px]">
		   <Card descricao="Projetos Comunitários" background="bg-orange-400 w-[90%] "/>
		   </div>
		   <div class="flex flex-col bg-orange-300 py-6 rounded-xl items-center">
			 <img src="/img/comunidade.png" class="md:w-[80px] w-[100px]">
		   <Card descricao="Parcerias" background="bg-orange-400 w-[90%] "/>
		 </div>
		</div>
	</section>
	
	<section class="resumo mt-24 md:mt-0  flex flex-col w-full justify-center items-center md:grid-cols-2 md:h-[500px] ">
	    
		<div class="sobre p-6 mt-6 flex flex-col items-center w-[70%]">
		    <h4 class="font-bold text-4xl text-orange-400 text-center mb-2">Sobre a CDH</h4>
		    <p class="mb-2 text-xl text-center text-gray-500">
				
			<b>Surgimos</b> pela pela iniciativa de reunir toda uma comunidade de profissionais</br>
			entusiastas e simpatizantes das <b>Tecnologias de Informação e Comunicação</b></br> da cidade visando alargar o nível de exposição dos talentos locais</br> no uso e produção de soluções tecnológicas emergentes...</p>
		    <CallAction texto="Saber mais!" link="/quem-somos"/>
	    </div>

	    <div class="p-6 py-12 h-[300px] grid grid-cols-2 bg-white text-white md:hidden">
	        <Card titulo="Visão" descricao="Ver o Huambo reconhecido como um polo tecnólogico nacional." background="bg-orange-400"/>
		    <Card titulo="Missão" descricao="Ser uma ponte entre o potencial humano nas tecnologias e as oportunidades emergentes" background="bg-orange-400"/>
 	    </div>

		 <div class='z-10'>
			 <div style={{zIndex:"auto", backgroundImage: `url(img/cdh/iconePNG.png)`, backgroundSize: "Cover", backgroundPosition: "center",animationDuration:"3s"}} class="mt-4 relative w-[200px] h-[200px] animate-spin"></div>
		</div>
	</section>

	<section class="newletter mt-6 p-6 flex justify-center md:bg-white">
	   <Newsletter email="joaob.mesquita1@gmail.com" client:load/>
	</section>
</Layout>
