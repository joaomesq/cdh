---
//components
import Slider from '../components/Slider/Slider.tsx';
import Card from '../components/Card/Card.tsx';
import CallAction from '../components/Call-To-Action/Call-Action.tsx';
import Newsletter from '../components/Newsletter/Newsletter.tsx';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <section class="slide">
	    <Slider client:load/>
	</section>

	<section class="fazer-parte p-4 py-6 text-center mt-12 mb-8">
	    <div class="lg:w-1/2 md:mx-auto">
		    <h2 class="font-bold mb-4 text-3xl text-gray-700">Por que fazer parte da CDH?</h2>
			<p class="text-gray-400 text-xl">A CDH ofere um ambiente colaborativo para desenvolvedores crescerem profissionalmente e contribuírem para o ecossistema tecnológico angolano.</p>
		</div>

		<div class="cards-motivos mt-16 md:grid md:grid-cols-2 lg:grid-cols-4 lg:px-8 lg:gap-4">
		    <Card titulo="Networking" background="bg-cdh-teal bg-opacity-5" descricao="Conecte-se com outros desenvolvedores, partilhe conhecimento e crie oportunidades de colaboração."/>
		    <Card background="bg-cdh-purple bg-opacity-5" titulo="Desenvolvimento Prático" descricao="Participe em projectos reais e desenvolva habilidades através de experiências práticas e colaborativas."/>
			<Card titulo="Inovação" descricao="Trabalhe em soluções inovadoras que impactem positivamente a comunidade angolana." background="bg-cdh-teal bg-opacity-5"/>
		    <Card background="bg-cdh-purple bg-opacity-5" titulo="Impacto Social" descricao="Contribua para projectos que geram impacto positivo na sociedade angolana através da tecnologia."/>
		</div>
	</section>

	<section class="resumo bg-cdh-teal bg-opcity-40 p-4 py-16 text-center">
	    <h2 class="font-bold text-3xl text-gray-700">Sobre a CDH</h2>
		<p class="lg:w-1/2 md:mx-auto text-gray-200 text-lg mt-8 mx-4 mb-8">Surgimos pela iniciativa de reunir toda uma comunidade de profissionais, entusiastas e simpatizantes das TIC's da cidade do Huambo, visando alargar o nível de exposição dos talentos locais no uso e produção de soluções tecnológicas emergentes...</p>
		<CallAction link="/quem-somos" texto="Ver mais ->" target="_self" background="bg-gray-700"/>
	</section>

	<section class="atuacao p-4">
	    <div class="text-center mt-12 mb-8 lg:w-1/2 md:mx-auto">
		    <h2 class="text-3xl font-bold mb-4 text-gray-700">Áreas de Atuação</h2>
			<p class="text-gray-400 text-xl">Conheça os nossos principais focos de trabalho e como contribuímos para o desenvolvimento tecnológico</p>
		</div>

		<div class="cards mt-16 md:grid md:grid-cols-2 lg:grid-cols-4 lg:px-8 lg:gap-4">
		    <Card titulo="Formação e Mentorias" descricao="Capacitação técnica e orientação profissional para desenvolvedores e profissionais de tecnologia em diferentes níveis." background="bg-cdh-pink bg-opacity-5"/>
			<Card background="bg-white" titulo="Hackthons e Eventos" descricao="Organização de eventos que promovem a inovação e o networking entre profissionais."/>
			<Card titulo="Projectos Comunitários" descricao="Desenvolvimento de soluções tecnológicas que beneficiam a comunidade local." background="bg-cdh-pink bg-opacity-5"/>
			<Card background="bg-white" titulo="Parcerias" descricao="Colaboração estratégica com empresas e instituições para ampliar oportunidades."/>
		</div>
	</section>

	<section class="newsletter">
	    <Newsletter email="joaobmesquita1@gmail.com"/>
	</section>
</Layout>
