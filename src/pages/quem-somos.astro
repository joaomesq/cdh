---
import Quem_Somos from '../components/Quem-Somos/Quem_Somos.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero/Hero.astro';
import NossaHistoria from '../components/Quem-Somos/NossaHistoria.jsx';
import MissaoVisaoValores from '../components/Quem-Somos/MissaoVisaoValores.jsx';
import OqueFazemos from '../components/Quem-Somos/OqueFazemos/OqueFazemos.astro';
---

<Layout>
  <section class="hero">
    <Hero titulo="Quem Somos" descricao="A Comunidade de Desenvolvedores do Huambo é uma organização sem fins lucrativos dedicada ao crescimento e desenvolvimento do sector tecnológico no Huambo e Angola."/>
  </section>
  
  <section class="historia bg-cdh-dark bg-opacity-5">
    <NossaHistoria />
  </section>

  <section class="missao-visao-valores">
    <MissaoVisaoValores />
  </section>
  
  <section class="oque-fazemos bg-cdh-dark bg-opacity-5">
    <OqueFazemos />
  </section>
</Layout>