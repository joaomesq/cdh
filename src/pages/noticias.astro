---
import Layout from "../layouts/Layout.astro";

import { getCollection } from 'astro:content';
const all = (await getCollection('noticias')).sort((a,b)=> (a.data.publishedAt < b.data.publishedAt?1:-1));
---

<Layout>

  <section class="bg-gray-50">
    <div class="text-center py-16 bg-gradient-to-br mb-5 h-[600px] flex items-center flex-col justify-center shadow-sm" style={{ backgroundImage: `url(img/cdh/22.png)`, backgroundSize: "Cover", backgroundPosition: "center"}}>
      <h1 class="text-4xl font-bold text-white mb-4">Explore nossos Artigos</h1>
      <p class="text-lg text-white font-semibold max-w-2xl mx-auto">
        Dicas práticas, experiências da comunidade, soluções em código 
        <br> tudo isso você encontra aqui. 
      </p>
    </div>

    <div class="p-4 grid gap-6 md:grid-cols-3">
      {all.map((n)=> (
        <article class="shadow bg-white pb-4 rounded-lg">
          {n.data.cover && <img src={n.data.cover} alt="" class="mb-3 h-[180px] w-full rounded-t-lg object-cover" />}
          <h3 class="mb-1 mt-4 px-2 text-lg font-bold">{n.data.title}</h3>
          <p class="mb-2 px-2 text-sm text-gray-600">{new Date(n.data.publishedAt).toLocaleDateString('pt-PT')} — {n.data.category}</p>
          <p class="mb-3 px-2 text-gray-700">{n.data.summary}</p>
          <p class="mb-3 px-2 text-sm text-gray-700">Autor: <strong>{n.data.author}</strong></p>
          <a href={`/noticias/${n.slug}/`} class="text-cdh-blue px-2 hover:underline">Ler artigo completo</a>
        </article>
      ))}
    </div>
  </section>


<section class="bg-gradient-to-r from-orange-200 to-orange-400  shadow-lg p-8 text-center text-white ">
  <h2 class="text-3xl md:text-4xl font-bold mb-4">
    Continue a sua jornada de conhecimento 
  </h2>
  <p class="text-lg mb-6">
    Explore mais artigos, compartilhe ideias e faça parte da nossa comunidade de desenvolvimento.
  </p>
  <a href="/contatos" class="inline-block bg-white text-orange-400 font-semibold px-6 py-3 rounded-lg shadow hover:shadow-xl transition-transform transform hover:scale-105">
    Enviar meu artigo
  </a>
</section>
</Layout>